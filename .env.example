# Copy to .env and fill in any free keys you have. Every one is optional:
# missing providers are skipped, and the offline mock engine always works.

# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Local Ollama (https://ollama.com/download), e.g. http://127.0.0.1:11434
OLLAMA_URL=

# Optional model overrides (defaults in lib/personality/config.ts)
GROQ_MODEL=
GEMINI_MODEL=
OPENROUTER_MODEL=
OLLAMA_MODEL=

# Mirage vision service (started by `npm run dev`)
MIRAGE_URL=http://127.0.0.1:8765
