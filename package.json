{
  "name": "anima-objects-have-feelings",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm install && node scripts/mirage.mjs setup && npm run db:migrate",
    "dev": "concurrently -k -n web,mirage -c magenta,cyan \"npm:dev:web\" \"npm:dev:mirage\"",
    "dev:web": "next dev -H 0.0.0.0",
    "dev:https": "concurrently -k -n web,mirage \"next dev -H 0.0.0.0 --experimental-https\" \"npm:dev:mirage\"",
    "dev:mirage": "node scripts/mirage.mjs serve",
    "build": "next build",
    "start": "concurrently -k -n web,mirage \"next start -H 0.0.0.0\" \"npm:dev:mirage\"",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:py": "node scripts/mirage.mjs test",
    "test:e2e": "playwright test",
    "check:providers": "tsx scripts/check-providers.ts",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:reset": "tsx scripts/db.ts reset",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:py && npm run build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
